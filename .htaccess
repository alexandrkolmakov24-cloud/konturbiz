# =====================================================================
# KONTURBIZ — .htaccess  (SpaceWeb: Apache 2.4 + PHP 8.3, UTF-8)
# Перед выкладкой проверить на тестовой папке: mod_rewrite, mod_headers,
# mod_deflate, mod_expires, mod_setenvif обычно включены на SpaceWeb.
# =====================================================================

# --- Кодировка и главная ---------------------------------------------
AddDefaultCharset UTF-8
AddCharset UTF-8 .html .css .js .json .xml .txt
DirectoryIndex index.html index.php
Options -Indexes

# --- HTTPS и один адрес (без www) ------------------------------------
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

RewriteCond %{HTTP_HOST} ^www\.konturbiz\.ru$ [NC]
RewriteRule ^ https://konturbiz.ru%{REQUEST_URI} [L,R=301]
</IfModule>

# --- Управление индексацией (ОДНО МЕСТО) -------------------------------
# Всё, что попало под KB_NOINDEX, получает заголовок
# X-Robots-Tag: noindex, follow. Открыть = удалить строку.
# Закрыть раздел позже = раскомментировать строку или добавить свою.
# Не закрывайте эти адреса в robots.txt: робот не увидит noindex.
<IfModule mod_setenvif.c>
# служебное и нерабочее
SetEnvIf Request_URI "^/m(/|$)"                 KB_NOINDEX
SetEnvIf Request_URI "^/konturscan(/|$)"        KB_NOINDEX
SetEnvIf Request_URI "^/test-govsupport(/|$)"   KB_NOINDEX
SetEnvIf Request_URI "^/pages/_reference(/|$)"  KB_NOINDEX
# домен-зеркало rcbiz.ru закрыт целиком
SetEnvIf Host "(^|\.)rcbiz\.ru$"                KB_NOINDEX

# примеры закрытия разделов на время наполнения (сейчас всё открыто):
# SetEnvIf Request_URI "^/pages/knowledge(/|$)"   KB_NOINDEX
# SetEnvIf Request_URI "^/pages/cases(/|$)"       KB_NOINDEX
</IfModule>

<IfModule mod_headers.c>
Header always set X-Robots-Tag "noindex, follow" env=KB_NOINDEX

Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# --- Закрытые файлы и папки ---------------------------------------------
<FilesMatch "(^\.|\.(md|zip|bak|log|sql)$|^config\.php$)">
  Require all denied
</FilesMatch>
<FilesMatch "^(llms|llms-full|humans|robots)\.txt$">
  Require all granted
</FilesMatch>
RedirectMatch 404 /\.git

# --- Сжатие ----------------------------------------------------------------
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript
AddOutputFilterByType DEFLATE application/javascript application/json application/xml image/svg+xml
</IfModule>

# --- Кэш браузера -----------------------------------------------------------
<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType image/webp  "access plus 1 year"
ExpiresByType image/png   "access plus 1 year"
ExpiresByType image/jpeg  "access plus 1 year"
ExpiresByType image/svg+xml "access plus 1 year"
ExpiresByType image/x-icon "access plus 1 year"
ExpiresByType font/woff2  "access plus 1 year"
ExpiresByType video/mp4   "access plus 1 month"
ExpiresByType text/css    "access plus 1 month"
ExpiresByType application/javascript "access plus 1 month"
ExpiresByType text/javascript "access plus 1 month"
ExpiresByType text/html   "access plus 0 seconds"
</IfModule>
